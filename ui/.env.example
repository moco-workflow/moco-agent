# Moco server API base URL (empty = same origin, Vite proxy handles in dev)
VITE_API_BASE_URL=

# OAuth2 configuration
VITE_OAUTH_AUTHORIZE_URL=
VITE_OAUTH_TOKEN_URL=
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_REDIRECT_URI_PATH=/callback
VITE_OAUTH_SCOPE=openid profile email
VITE_AUTH_TOKEN_TYPE=access_token

# App base path (for sub-path deployments)
VITE_APP_BASE=/

# API key used as the credential for guest mode (Authorization: Bearer <key>).
# Leave empty to have guest requests go out unauthenticated.
VITE_GUEST_APIKEY=

VITE_AUTH_TOKEN_TYPE=access_token
VITE_OAUTH_EXTRA_AUTH_PARAMS=

# Google build: opaque access token, so send the id token
#   VITE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
#   VITE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
#   VITE_OAUTH_REDIRECT_URI_PATH=/api/auth/callback/google
#   VITE_AUTH_TOKEN_TYPE=id_token
#   VITE_OAUTH_EXTRA_AUTH_PARAMS=access_type=offline&prompt=consent

VITE_EXECUTE_MODE=standalone-activity        # in-memory | standalone-activity | workflow
VITE_ENABLE_OTEL_TRACE=false      # true | false
